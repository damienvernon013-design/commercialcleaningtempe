# Environment Variables Template
# Copy to .env.local for local development
# For Vercel, configure these in the Vercel dashboard

# Contact form email destination
CONTACT_EMAIL=ops@thequotemasters.com

# Site URL for canonical links and redirects
NEXT_PUBLIC_SITE_URL=https://commercialcleaningtempe.com

# Optional: If using SendGrid or other email service
# SENDGRID_API_KEY=your_key_here
# SENDGRID_FROM_EMAIL=noreply@commercialcleaningtempe.com

# Optional: If using Slack notifications for quote submissions
# SLACK_WEBHOOK_URL=your_webhook_url

# Optional: If using Google Analytics
# NEXT_PUBLIC_GA_ID=G_XXXXXXXXXX

# Optional: CRM Integration
# PIPEDRIVE_API_TOKEN=your_token_here
# HUBSPOT_API_KEY=your_key_here
